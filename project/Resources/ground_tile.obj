# Ground Tile Mesh (25x25m tile with tiling grass UV)
mtllib ground_tile.mtl
o GroundTile
v -12.500000 0.000000 -12.500000
v  12.500000 0.000000 -12.500000
v  12.500000 0.000000  12.500000
v -12.500000 0.000000  12.500000
vt 0.000000 0.000000
vt 6.250000 0.000000
vt 6.250000 6.250000
vt 0.000000 6.250000
vn 0.000000 1.000000 0.000000
usemtl GroundMaterial
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
