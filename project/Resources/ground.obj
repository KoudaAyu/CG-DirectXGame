# Level Ground Mesh (Horizontal Ground Plane with Repeating Grass UVs)
mtllib ground.mtl
o Ground
v -50.000000 0.000000 -50.000000
v  50.000000 0.000000 -50.000000
v  50.000000 0.000000  50.000000
v -50.000000 0.000000  50.000000
vt 0.000000 0.000000
vt 25.000000 0.000000
vt 25.000000 25.000000
vt 0.000000 25.000000
vn 0.000000 1.000000 0.000000
usemtl GroundMaterial
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
