# 3D Oil Drum Stack Model (1.8m wide x 1.6m tall x 0.7m deep)
mtllib duckov_barrel_stack.mtl
o OilDrumStack

# Drum 1 (Left Red)
v -0.85  0.0 -0.35
v -0.15  0.0 -0.35
v -0.15  1.6 -0.35
v -0.85  1.6 -0.35
v -0.85  0.0  0.35
v -0.15  0.0  0.35
v -0.15  1.6  0.35
v -0.85  1.6  0.35

# Drum 2 (Right Yellow)
v  0.15  0.0 -0.35
v  0.85  0.0 -0.35
v  0.85  1.6 -0.35
v  0.15  1.6 -0.35
v  0.15  0.0  0.35
v  0.85  0.0  0.35
v  0.85  1.6  0.35
v  0.15  1.6  0.35

# UV
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Drum 1 Faces
usemtl DrumRed
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/2/2 8/3/2 7/4/2
f 5/2/2 7/4/2 6/1/2
